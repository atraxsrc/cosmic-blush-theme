# Blush for delta (the git diff pager), part of cosmic-blush-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat Blush theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/blush.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = blush

[delta "blush"]
    light = true
    syntax-theme = Blush
    navigate = true
    line-numbers = true

    file-style = bold "#9E4F5B"
    file-decoration-style = "#E3D2BB" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#E3D2BB" box
    hunk-header-file-style = "#8C6A4E"
    hunk-header-line-number-style = "#644535"

    minus-style = "#A02B16" "#FDF7EE"
    minus-emph-style = bold "#F5E6D3" "#A02B16"
    minus-non-emph-style = "#A02B16" "#FDF7EE"
    plus-style = "#76634C" "#FDF7EE"
    plus-emph-style = bold "#F5E6D3" "#76634C"
    plus-non-emph-style = "#76634C" "#FDF7EE"
    zero-style = syntax
    whitespace-error-style = "#F5E6D3" "#9B5625"

    line-numbers-left-style = "#E3D2BB"
    line-numbers-right-style = "#E3D2BB"
    line-numbers-minus-style = "#A02B16"
    line-numbers-plus-style = "#76634C"
    line-numbers-zero-style = "#A89584"

    commit-style = bold "#644535"
    commit-decoration-style = "#E3D2BB" box
    blame-palette = "#F5E6D3 #FDF7EE #ECDCC6"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#76634C"
    merge-conflict-theirs-diff-header-style = bold "#9B5625"
