# Blush for Ghostty, part of cosmic-blush-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = Blush
# or, with the Blush Night half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:BlushNight,light:Blush

